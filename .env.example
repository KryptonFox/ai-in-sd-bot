# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.
# Несекретные значения по умолчанию живут в config.toml. Перечисленные ниже
# параметры — примеры переопределений; раскомментируйте только нужные.

# Telegram
# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# PostgreSQL
# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

# LLM-провайдер: ключ обязателен, остальное задано в config.toml.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# OpenCode Go: заполните LLM_API_KEY выше и раскомментируйте профиль.
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_MODEL=deepseek-v4.1-flash
# LLM_OPENCODE_SESSION=1
# DEFAULT_CONTEXT_LENGTH=131072
# LLM_MAX_TOKENS=32768
# LLM_GENERATION_RESERVE_TOKENS=4096

# Router (OpenAI Decisions API): базовые значения заданы в config.toml.
# ROUTER_API_KEY нужен для отдельного ключа Router. Если он пуст и основной
# профиль LLM использует OpenCode Go, применяется LLM_API_KEY.
ROUTER_API_KEY=
# ROUTER_BASE_URL=https://opencode.ai/inference/go/openai/v1
# ROUTER_MODEL=gpt-6-luna-decision
# ROUTER_TIMEOUT=30
# ROUTER_OPENCODE_SESSION=1

# Переопределения общих настроек LLM.
# LLM_TIMEOUT=180.0
# LLM_MAX_TOKENS=16384
# LLM_GENERATION_RESERVE_TOKENS=4096
# LLM_STREAMING=true
# LLM_CONTEXT_PROVIDER=auto

# История и компактизация: значения по умолчанию в config.toml.
# HISTORY_MAX_MESSAGES=10
# HISTORY_MAX_CHARS=8000
# DEFAULT_CONTEXT_LENGTH=32768
# COMPACTION_THRESHOLD_MESSAGES=10
# COMPACTION_KEEP_RECENT=3
# SUMMARY_MAX_CHARS=2000

# Агент: значения по умолчанию в config.toml.
# AGENT_TIMEOUT=240
# AGENT_MAX_TOOL_CALLS=5
# AGENT_MAX_LLM_STEPS=4
# CONFIRMATION_TTL=300
# TOOL_RESULT_MAX_CHARS=12000

# MCP: адреса контейнеров задаёт Compose, остальное — config.toml.
# MCP_TRANSPORT=stdio
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# MATH_MCP_SERVER_URL=
# MCP_TIMEOUT=10
# MATH_MCP_REQUEST_TIMEOUT_SECONDS=40
MCP_SHARED_SECRET=

# Пределы вычислительного процесса MathMCP: значения по умолчанию в config.toml.
# MATH_MCP_STARTUP_TIMEOUT_SECONDS=30
# MATH_MCP_OPERATION_TIMEOUT_SECONDS=5
# MATH_MCP_QUEUE_TIMEOUT_SECONDS=5
# MATH_MCP_MEMORY_LIMIT_MIB=768
# MATH_MCP_MAX_PNG_BYTES=262144

# Необязательные отдельные профили для compose.config.yaml; обычный compose
# использует встроенный в образ config.toml.
# BOT_CONFIG_FILE=./config.toml
# MATH_MCP_CONFIG_FILE=./config.toml

# Расписание
SCHEDULE_PATH=mcp_servers/student_tools/data/schedule.json
SCHEDULE_TIMEZONE=Europe/Moscow

# Веб-поиск Knowledge: provider = disabled | brave | exa в config.toml
# [web_search]. Для brave задайте ключ здесь; exa работает без ключа через
# hosted MCP https://mcp.exa.ai/mcp?tools=web_search_exa и не принимает
# API-ключ или OAuth-credentials. Для exa задайте MCP_TIMEOUT выше
# WEB_SEARCH_TIMEOUT_SECONDS с запасом на создание MCP-сессии.
# В облаке сервис student-tools-mcp получает настройки явно; Router и MathMCP — нет.
# WEB_SEARCH_PROVIDER=exa
# WEB_SEARCH_ENDPOINT=https://mcp.exa.ai/mcp?tools=web_search_exa
# WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_API_KEY=

# Сервисные настройки
LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080
# USER_QUEUE_MAX_SIZE=3
