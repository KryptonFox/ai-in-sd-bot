# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# LLM (OpenAI-совместимый API / Ollama / OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=180.0
LLM_MAX_TOKENS=16384
AGENT_TIMEOUT=240
LLM_CONTEXT_PROVIDER=auto

# Лимиты истории и компактизация
HISTORY_MAX_MESSAGES=10
HISTORY_MAX_CHARS=8000
DEFAULT_CONTEXT_LENGTH=32768
COMPACTION_THRESHOLD_MESSAGES=10
COMPACTION_KEEP_RECENT=3
SUMMARY_MAX_CHARS=2000
TOOL_RESULT_MAX_CHARS=12000
USER_QUEUE_MAX_SIZE=3

MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TIMEOUT=10
AGENT_MAX_TOOL_CALLS=2
AGENT_MAX_LLM_STEPS=4
CONFIRMATION_TTL=300
MCP_SHARED_SECRET=
SCHEDULE_PATH=app/data/schedule.json
SCHEDULE_TIMEZONE=Europe/Moscow

