{
  "version": 1,
  "cases": [
    {
      "id": "improper-log",
      "query": "Вычисли точно несобственный интеграл от 0 до бесконечности ln(1+x²)/(1+x²). Объясни сходимость.",
      "reference": "Подстановка x=tan(t), результат π ln 2. При x→∞ подынтегральная функция O(log x/x²).",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "integrate",
            "expression": "log(1+x^2)/(1+x^2)",
            "lower": 0,
            "upper": "oo"
          },
          "expected": {
            "status": "ok",
            "result": "pi*log(2)",
            "convergence": "convergent"
          }
        }
      ]
    },
    {
      "id": "limit-cancellation",
      "query": "Найди двусторонний предел (sin(x)−x+x³/6)/x⁵ при x→0 и объясни, какие члены сокращаются.",
      "reference": "1/120. Сокращаются члены степеней 1 и 3.",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "limit",
            "expression": "(sin(x)-x+x^3/6)/x^5",
            "point": 0
          },
          "expected": {
            "status": "ok",
            "result": "1/120"
          }
        }
      ]
    },
    {
      "id": "one-sided-limit",
      "query": "Найди предел (1−cos x)/x² при x→0 справа. Дай точное значение.",
      "reference": "1/2; можно применить формулу 1−cos(x)=2 sin²(x/2).",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "limit",
            "expression": "(1-cos(x))/x^2",
            "point": 0,
            "direction": "right"
          },
          "expected": {
            "status": "ok",
            "result": "1/2"
          }
        }
      ]
    },
    {
      "id": "two-sided-disagreement",
      "query": "Существует ли двусторонний предел |x|/x при x→0? Укажи оба односторонних предела.",
      "reference": "Слева −1, справа 1. Двусторонний предел не существует.",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "limit",
            "expression": "abs(x)/x",
            "point": 0,
            "direction": "left"
          },
          "expected": {
            "status": "ok",
            "result": "-1"
          }
        },
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "limit",
            "expression": "abs(x)/x",
            "point": 0,
            "direction": "right"
          },
          "expected": {
            "status": "ok",
            "result": "1"
          }
        }
      ]
    },
    {
      "id": "divergent-integral",
      "query": "Вычисли или докажи расходимость интеграла от 1 до бесконечности 1/x. Как ведут себя усечённые интегралы?",
      "reference": "Расходится к +∞. Интеграл до R равен ln R.",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "integrate",
            "expression": "1/x",
            "lower": 1,
            "upper": "oo"
          },
          "expected": {
            "status": "ok",
            "result": "oo",
            "convergence": "divergent"
          }
        }
      ]
    },
    {
      "id": "series-converges",
      "query": "Проверь сходимость ряда от n=1 до бесконечности 1/n². Если можешь, приведи точную сумму.",
      "reference": "Сходится абсолютно по p-признаку с p=2, сумма π²/6.",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "series",
            "expression": "1/n^2",
            "variable": "n",
            "lower": 1,
            "upper": "oo"
          },
          "expected": {
            "status": "ok",
            "result": "pi**2/6",
            "convergence": "convergent",
            "absolute_convergence": "convergent",
            "conditional": false
          }
        }
      ]
    },
    {
      "id": "series-conditional",
      "query": "Сходится ли ряд от n=1 до бесконечности (−1)^(n−1)/n абсолютно или условно? Если известна точная сумма, укажи её.",
      "reference": "Сходится условно по Лейбницу. Ряд модулей гармонический. Сумма ln 2.",
      "direct": [
        {
          "name": "math_calculate",
          "arguments": {
            "operation": "series",
            "expression": "(-1)^(n-1)/n",
            "variable": "n",
            "lower": 1,
            "upper": "oo"
          },
          "expected": {
            "status": "ok",
            "result": "log(2)",
            "convergence": "convergent",
            "absolute_convergence": "divergent",
            "conditional": true
          }
        }
      ]
    },
